{
  "pipelineVersion": 1,
  "language": "vi",
  "runtime": {
    "platform": "auto",
    "accelerator": "auto",
    "acceleratorFallback": "cpu",
    "toolDiscovery": "environment-then-path",
    "environmentVariables": {
      "ffmpeg": "LYRICRAIL_FFMPEG",
      "ffprobe": "LYRICRAIL_FFPROBE",
      "lrail": "LYRICRAIL_LRAIL",
      "projectRoot": "LYRICRAIL_HOME",
      "dataRoot": "LYRICRAIL_DATA_HOME"
    },
    "paths": {
      "input": "input",
      "output": "output",
      "cache": "cache",
      "models": "models",
      "logs": "logs",
      "credentials": "credentials"
    }
  },
  "quality": {
    "mode": "maximum",
    "preserveSourceResolution": true,
    "preserveSourceFrameRate": true,
    "preserveAspectRatio": true,
    "upscale": false,
    "deinterlaceWhenNeeded": true,
    "sdrColorSpace": "bt709",
    "youtubeUpload": {
      "container": "mp4",
      "videoCodec": "libx264",
      "profile": "high",
      "preset": "slow",
      "crf": 16,
      "pixelFormat": "yuv420p",
      "colorPrimaries": "bt709",
      "colorTransfer": "bt709",
      "colorSpace": "bt709",
      "colorRange": "tv",
      "bFrames": 2,
      "closedGop": true,
      "fastStart": true,
      "audioCodec": "aac",
      "audioBitrate": "384k",
      "audioSampleRate": 48000,
      "audioChannels": 2
    },
    "appPlayback": {
      "layout": "synchronized-encrypted-assets",
      "videoContainer": "mp4",
      "audioContainer": "m4a",
      "videoPolicy": "stream-copy-when-timeline-allows",
      "fallbackVideoCodec": "libx264",
      "fallbackProfile": "high",
      "fallbackPreset": "slow",
      "fallbackCrf": 18,
      "fallbackPixelFormat": "yuv420p",
      "audioCodec": "aac",
      "audioBitrate": "256k",
      "audioSampleRate": 48000,
      "audioChannels": 2
    }
  },
  "audioSeparation": {
    "engine": "audio-separator",
    "target": "all-vocals",
    "modelPolicy": "resurrection-instrumental-with-transactional-lexical-cleanup",
    "ensemblePreset": "",
    "allowModelFallback": false,
    "modelFilename": "bs_roformer_instrumental_resurrection_unwa.ckpt",
    "useAutocast": true,
    "intermediateFormat": "flac",
    "sampleRate": 48000,
    "keepVocals": true,
    "keepInstrumental": true,
    "qualityGates": {
      "maximumDurationDeltaSeconds": 0.05,
      "maximumSourceSamplePeak": 1.0,
      "maximumSamplePeak": 0.999,
      "minimumReconstructionSnrDb": 15.0,
      "minimumInstrumentEnergyRatioDb": -18.0,
      "maximumInstrumentEnergyRatioDb": 3.0,
      "minimumVocalEnergyRatioDb": -24.0,
      "maximumVocalEnergyRatioDb": 3.0
    }
  },
  "audioOnlyVisuals": {
    "enabled": true,
    "strategy": "content-derived-semantic-landscape",
