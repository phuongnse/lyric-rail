{
  "name": "lyricrail-desktop",
  "private": true,
  "version": "0.8.0",
  "workspaces": [
    "apps/player",
    "packages/ui"
  ],
  "scripts": {
    "brand:icons": "node scripts/generate_brand_icons.mjs",
    "build": "npm run build --workspaces --if-present",
    "build:player": "npm run build --workspace @lyricrail/player",
    "dev:player": "npm run tauri dev --workspace @lyricrail/player",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
