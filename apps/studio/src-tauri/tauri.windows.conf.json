{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBundleCommand": "npm run prepare:broker"
  },
  "bundle": {
    "windows": {
      "allowDowngrades": false,
      "wix": {
        "fragmentPaths": ["windows/volume-broker.wxs"],
        "componentRefs": ["LyricRailVolumeBrokerComponent"]
      },
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "windows/volume-broker-hooks.nsh"
      }
    }
  }
}
