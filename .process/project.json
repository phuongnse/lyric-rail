{
  "impactProfiles": {
    "profiles": {
      "frontend": [
        {
          "id": "frontend-policy-refresh",
          "paths": [
            ".github/dependabot.yml",
            ".github/dependabot.yaml",
            ".github/renovate.json5",
            ".github/workflows/**",
            ".process/project.json",
            ".process/readiness.json"
          ],
          "run": [
            "processctl",
            "verify",
            "--project-root",
            ".",
            "--profile",
            "frontend"
          ],
          "timeoutSeconds": 3000
        },
        {
          "id": "frontend-adoption-integrity",
          "paths": [
            ".agents/skills/**",
            ".github/PULL_REQUEST_TEMPLATE.md",
            ".process/adopt-process-windows-job.py",
            ".process/adopt-process.py",
            ".process/process.lock",
            "AGENTS.md",
            "requirements/process.in",
            "requirements/process.txt"
          ],
          "run": [
            "processctl",
            "doctor",
            "--project-root",
            "."
          ],
          "timeoutSeconds": 900
        }
      ],
      "python": [
        {
          "id": "python-policy-refresh",
          "paths": [
            ".github/dependabot.yml",
            ".github/dependabot.yaml",
            ".github/renovate.json5",
            ".github/workflows/**",
            ".process/project.json",
            ".process/readiness.json"
          ],
          "run": [
            "processctl",
            "verify",
            "--project-root",
            ".",
            "--profile",
            "python"
          ],
          "timeoutSeconds": 4200
        },
        {
          "id": "python-adoption-integrity",
          "paths": [
            ".agents/skills/**",
            ".github/PULL_REQUEST_TEMPLATE.md",
            ".process/adopt-process-windows-job.py",
            ".process/adopt-process.py",
            ".process/process.lock",
            "AGENTS.md",
            "requirements/process.in",
            "requirements/process.txt"
          ],
          "run": [
            "processctl",
            "doctor",
            "--project-root",
            "."
          ],
          "timeoutSeconds": 900
        }
      ],
      "rust": [
        {
          "id": "rust-policy-refresh",
          "paths": [
            ".github/dependabot.yml",
            ".github/dependabot.yaml",
            ".github/renovate.json5",
            ".github/workflows/**",
            ".process/project.json",
            ".process/readiness.json"
          ],
          "run": [
            "processctl",
            "verify",
            "--project-root",
            ".",
            "--profile",
            "rust"
          ],
          "timeoutSeconds": 4800
        },
        {
          "id": "rust-adoption-integrity",
          "paths": [
            ".agents/skills/**",
            ".github/PULL_REQUEST_TEMPLATE.md",
            ".process/adopt-process-windows-job.py",
            ".process/adopt-process.py",
            ".process/process.lock",
            "AGENTS.md",
            "requirements/process.in",
            "requirements/process.txt"
          ],
          "run": [
            "processctl",
            "doctor",
            "--project-root",
            "."
          ],
          "timeoutSeconds": 900
        }
      ],
      "security": [
        {
          "id": "security-policy-refresh",
          "paths": [
            ".github/dependabot.yml",
            ".github/dependabot.yaml",
            ".github/renovate.json5",
            ".github/workflows/**",
            ".process/project.json",
            ".process/readiness.json"
          ],
          "run": [
            "processctl",
            "verify",
            "--project-root",
            ".",
            "--profile",
            "security"
          ],
          "timeoutSeconds": 4500
        },
        {
          "id": "security-adoption-integrity",
          "paths": [
            ".agents/skills/**",
            ".github/PULL_REQUEST_TEMPLATE.md",
            ".process/adopt-process-windows-job.py",
            ".process/adopt-process.py",
            ".process/process.lock",
            "AGENTS.md",
            "requirements/process.in",
            "requirements/process.txt"
          ],
          "run": [
            "processctl",
            "doctor",
            "--project-root",
            "."
          ],
          "timeoutSeconds": 900
        }
      ]
    },
    "schemaVersion": 1
  },
  "lifecycle": {
    "publication": {
      "required": true
    },
    "requiredProfiles": [
      "frontend",
      "python",
      "rust"
    ]
  },
  "profiles": {
    "frontend": [
      {
        "id": "frontend-build",
        "run": [
          "python",
          "scripts/npm_command.py",
          "run",
          "build"
        ],
        "timeoutSeconds": 900
      },
      {
        "id": "frontend-tests",
        "run": [
          "python",
          "scripts/npm_command.py",
          "test"
        ],
        "timeoutSeconds": 900
      },
      {
        "id": "frontend-dependency-audit",
        "run": [
          "python",
          "scripts/npm_command.py",
          "audit",
          "--audit-level=moderate"
        ],
        "timeoutSeconds": 600
      }
    ],
    "python": [
      {
        "id": "python-compile",
        "run": [
          "python",
          "-m",
          "compileall",
          "-q",
          "src",
          "scripts"
        ],
        "timeoutSeconds": 300
      },
      {
        "id": "python-dependency-consistency",
        "run": [
          "python",
          "-m",
          "pip",
          "check"
        ],
        "timeoutSeconds": 300
      },
      {
        "id": "python-tests",
        "run": [
          "python",
          "-m",
          "pytest",
          "-q"
        ],
        "timeoutSeconds": 1800
      },
      {
        "id": "python-media-integration",
        "run": [
          "python",
          "-m",
          "pytest",
          "-q",
          "tests/test_player_media_delivery.py"
        ],
        "timeoutSeconds": 900
      }
    ],
    "rust": [
      {
        "id": "rust-format",
        "run": [
          "cargo",
          "fmt",
          "--all",
          "--check"
        ],
        "timeoutSeconds": 300
      },
      {
        "id": "rust-tests",
        "run": [
          "cargo",
          "test",
          "--workspace",
          "--locked"
        ],
        "timeoutSeconds": 1800
      },
      {
        "id": "rust-clippy",
        "run": [
          "cargo",
          "clippy",
          "--workspace",
          "--all-targets",
          "--locked",
          "--",
          "-D",
          "warnings"
        ],
        "timeoutSeconds": 1800
      }
    ],
    "security": [
      {
        "id": "python-dependency-audit",
        "run": [
          "python",
          "-m",
          "pip_audit",
          "--progress-spinner",
          "off"
        ],
        "timeoutSeconds": 900
      },
      {
        "id": "rust-dependency-audit",
        "run": [
          "python",
          "scripts/run_cargo_audit.py"
        ],
        "timeoutSeconds": 900
      },
      {
        "id": "package-fuzz-smoke",
        "run": [
          "python",
          "scripts/run_package_fuzz_smoke.py"
        ],
        "timeoutSeconds": 1800
      }
    ]
  },
  "project": "lyric-rail",
  "schemaVersion": 1
}
