{
  "lifecycle": {
    "publication": {
      "required": true
    },
    "requiredProfiles": [
      "frontend",
      "python",
      "rust"
    ]
  },
  "impactProfiles": {
    "schemaVersion": 1,
    "profiles": {
      "frontend": [
        {
          "id": "frontend-policy-refresh",
          "run": [
            "processctl",
            "verify",
            "--project-root",
            ".",
            "--profile",
            "frontend"
          ],
          "timeoutSeconds": 1800,
          "paths": [
            ".process/project.json",
            ".process/readiness.json",
            ".github/**"
          ]
        },
        {
          "id": "frontend-build",
          "run": [
            "python",
            "scripts/npm_command.py",
            "run",
            "build"
          ],
          "timeoutSeconds": 900,
          "paths": [
            "package.json",
            "package-lock.json",
            "apps/player/**",
            "scripts/npm_command.py"
          ]
        },
        {
          "id": "frontend-tests",
          "run": [
            "python",
            "scripts/npm_command.py",
            "test"
          ],
          "timeoutSeconds": 900,
          "paths": [
            "package.json",
            "package-lock.json",
            "apps/player/**",
            "scripts/npm_command.py"
          ]
        },
        {
          "id": "frontend-dependency-audit",
          "run": [
            "python",
            "scripts/npm_command.py",
            "audit",
            "--audit-level=moderate"
          ],
          "timeoutSeconds": 600,
          "paths": [
            "package.json",
            "package-lock.json"
          ]
        }
      ],
      "python": [
        {
          "id": "python-adoption-check",
          "run": [
            "processctl",
            "adoption",
            "check",
            "--project-root",
            ".",
            "--requirements-lock",
            "requirements/process.txt"
          ],
          "timeoutSeconds": 600,
          "paths": [
            ".agents/skills/**",
            ".process/adopt-process.py",
            ".process/adopt-process-windows-job.py",
            ".process/process.lock",
            "requirements/process.txt"
          ]
        },
        {
          "id": "python-adoption-doctor",
          "run": [
            "processctl",
            "doctor",
            "--project-root",
            "."
          ],
          "timeoutSeconds": 600,
          "paths": [
            ".agents/skills/**",
            ".process/adopt-process.py",
            ".process/adopt-process-windows-job.py",
            ".process/process.lock",
            "requirements/process.txt"
          ]
        },
        {
          "id": "python-policy-refresh",
          "run": [
            "processctl",
            "verify",
            "--project-root",
            ".",
            "--profile",
            "python"
          ],
          "timeoutSeconds": 1800,
          "paths": [
            ".process/project.json",
            ".process/readiness.json",
            ".github/**"
          ]
        },
        {
          "id": "python-compile",
          "run": [
            "python",
            "-m",
            "compileall",
            "-q",
            "src",
            "scripts"
          ],
          "timeoutSeconds": 300,
          "paths": [
            "src/**",
            "scripts/**",
            "pyproject.toml",
            "requirements/**",
            "config/**",
            "vendor/**"
          ]
        },
        {
          "id": "python-dependency-consistency",
          "run": [
            "python",
            "-m",
            "pip",
            "check"
          ],
          "timeoutSeconds": 300,
          "paths": [
            "pyproject.toml",
            "requirements/**"
          ]
        },
        {
          "id": "python-tests",
          "run": [
            "python",
            "-m",
            "pytest",
            "-q"
          ],
          "timeoutSeconds": 1800,
          "paths": [
            "src/**",
            "scripts/**",
            "tests/**",
            "pyproject.toml",
            "config/**",
            "vendor/**"
          ]
        },
        {
          "id": "python-media-integration",
          "run": [
            "python",
            "-m",
            "pytest",
            "-q",
            "tests/test_player_media_delivery.py"
          ],
          "timeoutSeconds": 900,
          "paths": [
            "src/lyricrail/local_pipeline.py",
            "src/lyricrail/runner.py",
            "src/lyricrail/subprocess_owner.py",
            "src/lyricrail/toolchain.py",
            "tests/test_local_pipeline.py",
            "tests/test_player_media_delivery.py",
            "tests/test_player_task_runtime.py",
            "config/pipeline.json"
          ]
        }
      ],
      "rust": [
        {
          "id": "rust-policy-refresh",
          "run": [
            "processctl",
            "verify",
            "--project-root",
            ".",
            "--profile",
            "rust"
          ],
          "timeoutSeconds": 1800,
          "paths": [
            ".process/project.json",
            ".process/readiness.json",
            ".github/**"
          ]
        },
        {
          "id": "rust-format",
          "run": [
            "cargo",
            "fmt",
            "--all",
            "--check"
          ],
          "timeoutSeconds": 300,
          "paths": [
            "Cargo.toml",
            "Cargo.lock",
            "crates/**",
            "fuzz/**",
            "apps/player/src-tauri/**"
          ]
        },
        {
          "id": "rust-tests",
          "run": [
            "cargo",
            "test",
            "--workspace",
            "--locked"
          ],
          "timeoutSeconds": 1800,
          "paths": [
            "Cargo.toml",
            "Cargo.lock",
            "crates/**",
            "fuzz/**",
            "apps/player/src-tauri/**"
          ]
        },
        {
          "id": "rust-clippy",
          "run": [
            "cargo",
            "clippy",
            "--workspace",
            "--all-targets",
            "--locked",
            "--",
            "-D",
            "warnings"
          ],
          "timeoutSeconds": 1800,
          "paths": [
            "Cargo.toml",
            "Cargo.lock",
            "crates/**",
            "fuzz/**",
            "apps/player/src-tauri/**"
          ]
        }
      ],
      "security": [
        {
          "id": "security-policy-refresh",
          "run": [
            "processctl",
            "verify",
            "--project-root",
            ".",
            "--profile",
            "security"
          ],
          "timeoutSeconds": 1800,
          "paths": [
            ".process/project.json",
            ".process/readiness.json",
            ".github/**"
          ]
        },
        {
          "id": "python-dependency-audit",
          "run": [
            "python",
            "-m",
            "pip_audit",
            "--progress-spinner",
            "off"
          ],
          "timeoutSeconds": 900,
          "paths": [
            "pyproject.toml",
            "requirements/**"
          ]
        },
        {
          "id": "rust-dependency-audit",
          "run": [
            "python",
            "scripts/run_cargo_audit.py"
          ],
          "timeoutSeconds": 900,
          "paths": [
            "Cargo.toml",
            "Cargo.lock",
            "crates/**",
            "fuzz/**",
            "apps/player/src-tauri/**"
          ]
        },
        {
          "id": "package-fuzz-smoke",
          "run": [
            "python",
            "scripts/run_package_fuzz_smoke.py"
          ],
          "timeoutSeconds": 1800,
          "paths": [
            "src/**",
            "crates/**",
            "fuzz/**",
            "tests/**",
            "scripts/run_package_fuzz_smoke.py"
          ]
        }
      ]
    }
  },
  "profiles": {
    "frontend": [
      {
        "id": "frontend-build",
        "run": [
          "python",
          "scripts/npm_command.py",
          "run",
          "build"
        ],
        "timeoutSeconds": 900
      },
      {
        "id": "frontend-tests",
        "run": [
          "python",
          "scripts/npm_command.py",
          "test"
        ],
        "timeoutSeconds": 900
      },
      {
        "id": "frontend-dependency-audit",
        "run": [
          "python",
          "scripts/npm_command.py",
          "audit",
          "--audit-level=moderate"
        ],
        "timeoutSeconds": 600
      }
    ],
    "python": [
      {
        "id": "python-compile",
        "run": [
          "python",
          "-m",
          "compileall",
          "-q",
          "src",
          "scripts"
        ],
        "timeoutSeconds": 300
      },
      {
        "id": "python-dependency-consistency",
        "run": [
          "python",
          "-m",
          "pip",
          "check"
        ],
        "timeoutSeconds": 300
      },
      {
        "id": "python-tests",
        "run": [
          "python",
          "-m",
          "pytest",
          "-q"
        ],
        "timeoutSeconds": 1800
      },
      {
        "id": "python-media-integration",
        "run": [
          "python",
          "-m",
          "pytest",
          "-q",
          "tests/test_player_media_delivery.py"
        ],
        "timeoutSeconds": 900
      }
    ],
    "rust": [
      {
        "id": "rust-format",
        "run": [
          "cargo",
          "fmt",
          "--all",
          "--check"
        ],
        "timeoutSeconds": 300
      },
      {
        "id": "rust-tests",
        "run": [
          "cargo",
          "test",
          "--workspace",
          "--locked"
        ],
        "timeoutSeconds": 1800
      },
      {
        "id": "rust-clippy",
        "run": [
          "cargo",
          "clippy",
          "--workspace",
          "--all-targets",
          "--locked",
          "--",
          "-D",
          "warnings"
        ],
        "timeoutSeconds": 1800
      }
    ],
    "security": [
      {
        "id": "python-dependency-audit",
        "run": [
          "python",
          "-m",
          "pip_audit",
          "--progress-spinner",
          "off"
        ],
        "timeoutSeconds": 900
      },
      {
        "id": "rust-dependency-audit",
        "run": [
          "python",
          "scripts/run_cargo_audit.py"
        ],
        "timeoutSeconds": 900
      },
      {
        "id": "package-fuzz-smoke",
        "run": [
          "python",
          "scripts/run_package_fuzz_smoke.py"
        ],
        "timeoutSeconds": 1800
      }
    ]
  },
  "project": "lyric-rail",
  "schemaVersion": 1
}
