{
  "schemaVersion": 4,
  "project": "lyric-rail",
  "lifecycle": {
    "requiredProfiles": [
      "frontend",
      "python",
      "rust"
    ],
    "qualityExtensions": [
      "project-cross-platform-release-evidence",
      "project-immutable-authoritative-lyrics",
      "project-no-cleartext-playback-artifact"
    ]
  },
  "profiles": {
    "frontend": [
      {
        "id": "frontend-build",
        "run": [
          "npm",
          "run",
          "build"
        ],
        "timeoutSeconds": 900
      },
      {
        "id": "frontend-tests",
        "run": [
          "npm",
          "test"
        ],
        "timeoutSeconds": 900
      },
      {
        "id": "frontend-dependency-audit",
        "run": [
          "npm",
          "audit",
          "--audit-level=moderate"
        ],
        "timeoutSeconds": 600
      }
    ],
    "python": [
      {
        "id": "python-compile",
        "run": [
          "python",
          "-m",
          "compileall",
          "-q",
          "src",
          "scripts"
        ],
        "timeoutSeconds": 300
      },
      {
        "id": "python-dependency-consistency",
        "run": [
          "python",
          "-m",
          "pip",
          "check"
        ],
        "timeoutSeconds": 300
      },
      {
        "id": "python-tests",
        "run": [
          "python",
          "-m",
          "pytest",
          "-q"
        ],
        "timeoutSeconds": 1800
      },
      {
        "id": "python-media-integration",
        "run": [
          "python",
          "-m",
          "pytest",
          "-q",
          "tests/test_player_media_delivery.py"
        ],
        "timeoutSeconds": 900
      }
    ],
    "rust": [
      {
        "id": "rust-format",
        "run": [
          "cargo",
          "fmt",
          "--all",
          "--check"
        ],
        "timeoutSeconds": 300
      },
      {
        "id": "rust-tests",
        "run": [
          "cargo",
          "test",
          "--workspace",
          "--locked"
        ],
        "timeoutSeconds": 1800
      },
      {
        "id": "rust-clippy",
        "run": [
          "cargo",
          "clippy",
          "--workspace",
          "--all-targets",
          "--locked",
          "--",
          "-D",
          "warnings"
        ],
        "timeoutSeconds": 1800
      }
    ],
    "security": [
      {
        "id": "python-dependency-audit",
        "run": [
          "python",
          "-m",
          "pip_audit",
          "--progress-spinner",
          "off"
        ],
        "timeoutSeconds": 900
      },
      {
        "id": "rust-dependency-audit",
        "run": [
          "cargo",
          "audit"
        ],
        "timeoutSeconds": 900
      },
      {
        "id": "package-fuzz-smoke",
        "run": [
          "python",
          "scripts/run_package_fuzz_smoke.py"
        ],
        "timeoutSeconds": 1800
      }
    ]
  },
  "environment": {
    "defaultProfile": "python",
    "foregroundOnly": true,
    "managedTools": [],
    "profiles": {
      "frontend": [
        "git-runtime",
        "node-runtime",
        "npm-runtime"
      ],
      "python": [
        "ffmpeg-runtime",
        "ffprobe-runtime",
        "git-runtime",
        "python-runtime"
      ],
      "rust": [
        "cargo-runtime",
        "git-runtime",
        "rust-clippy-runtime",
        "rust-runtime",
        "rustfmt-runtime"
      ],
      "security": [
        "cargo-audit-runtime",
        "cargo-fuzz-runtime",
        "cargo-runtime",
        "git-runtime",
        "pip-audit-runtime",
        "python-runtime",
        "rust-nightly-runtime",
        "rust-runtime"
      ]
    },
    "requirements": [
      {
        "id": "cargo-audit-runtime",
        "description": "cargo-audit required by the Rust dependency security gate",
        "probe": {
          "run": [
            "cargo",
            "audit",
            "--version"
          ],
          "timeoutSeconds": 30,
          "readOnly": true,
          "outputStream": "stdout",
          "outputRegex": "^cargo-audit-audit 0\\.22\\.2"
        },
        "remediation": "Install cargo-audit 0.22.2 with `cargo install cargo-audit --version 0.22.2 --locked`, then rerun doctor."
      },
      {
        "id": "cargo-fuzz-runtime",
        "description": "cargo-fuzz 0.13.2 required by the package parser fuzz gate",
        "probe": {
          "run": [
            "cargo",
            "fuzz",
            "--version"
          ],
          "timeoutSeconds": 30,
          "readOnly": true,
          "outputStream": "stdout",
          "outputRegex": "^cargo-fuzz 0\\.13\\.2"
        },
        "remediation": "Install cargo-fuzz 0.13.2 with `cargo install cargo-fuzz --version 0.13.2 --locked`, then rerun doctor."
      },
      {
        "id": "cargo-runtime",
        "description": "Cargo 1.85 or newer required by the Rust workspace",
        "probe": {
          "run": [
            "cargo",
            "--version"
          ],
          "timeoutSeconds": 15,
          "readOnly": true,
          "outputStream": "stdout",
          "outputRegex": "^cargo 1\\.(?:8[5-9]|9[0-9])\\."
        },
        "remediation": "Install a Rust stable toolchain at version 1.85 or newer, then rerun doctor."
      },
      {
        "id": "ffmpeg-runtime",
        "description": "FFmpeg required by media pipeline and integration tests",
        "probe": {
          "run": [
            "ffmpeg",
            "-version"
          ],
          "timeoutSeconds": 15,
          "readOnly": true,
          "outputStream": "stdout",
          "outputRegex": "^ffmpeg version\\s"
        },
        "remediation": "Install FFmpeg and expose `ffmpeg` on PATH, then rerun doctor."
      },
      {
        "id": "ffprobe-runtime",
        "description": "ffprobe required by source and output validation",
        "probe": {
          "run": [
            "ffprobe",
            "-version"
          ],
          "timeoutSeconds": 15,
          "readOnly": true,
          "outputStream": "stdout",
          "outputRegex": "^ffprobe version\\s"
        },
        "remediation": "Install FFmpeg and expose `ffprobe` on PATH, then rerun doctor."
      },
      {
        "id": "git-runtime",
        "description": "Git command-line client required for lifecycle checkpoints and source provenance",
        "probe": {
          "run": [
            "git",
            "--version"
          ],
          "timeoutSeconds": 15,
          "readOnly": true,
          "outputStream": "stdout",
          "outputRegex": "^git version 2\\.[0-9]+\\.[0-9]+"
        },
        "remediation": "Install a supported Git 2.x command-line client, then rerun doctor."
      },
      {
        "id": "node-runtime",
        "description": "Node.js 24 required by the desktop frontend workspaces",
        "probe": {
          "run": [
            "node",
            "--version"
          ],
          "timeoutSeconds": 15,
          "readOnly": true,
          "outputStream": "stdout",
          "outputRegex": "^v24\\.[0-9]+\\.[0-9]+"
        },
        "remediation": "Install Node.js 24, then rerun doctor."
      },
      {
        "id": "npm-runtime",
        "description": "npm 10 or 11 required by the locked frontend workspaces",
        "probe": {
          "run": [
            "npm",
            "--version"
          ],
          "timeoutSeconds": 15,
          "readOnly": true,
          "outputStream": "stdout",
          "outputRegex": "^(?:10|11)\\.[0-9]+\\.[0-9]+"
        },
        "remediation": "Install npm 10 or 11 with Node.js 24, then rerun doctor."
      },
      {
        "id": "pip-audit-runtime",
        "description": "pip-audit required by the Python dependency security gate",
        "probe": {
          "run": [
            "python",
            "-m",
            "pip_audit",
            "--version"
          ],
          "timeoutSeconds": 30,
          "readOnly": true,
          "outputStream": "stdout",
          "outputRegex": "^pip-audit 2\\."
        },
        "remediation": "Install pip-audit in the active Python environment, then rerun doctor."
      },
      {
        "id": "python-runtime",
        "description": "CPython 3.11 or newer required by the LyricRail pipeline",
        "probe": {
          "run": [
            "python",
            "--version"
          ],
          "timeoutSeconds": 15,
          "readOnly": true,
          "outputStream": "combined",
          "outputRegex": "^Python 3\\.(?:11|12|13|14)\\."
        },
        "remediation": "Install CPython 3.11 or newer and the project dependencies, then rerun doctor."
      },
      {
        "id": "rust-clippy-runtime",
        "description": "Clippy required by the strict Rust lint gate",
        "probe": {
          "run": [
            "cargo",
            "clippy",
            "--version"
          ],
          "timeoutSeconds": 30,
          "readOnly": true,
          "outputStream": "stdout",
          "outputRegex": "^clippy 0\\.1\\."
        },
        "remediation": "Install the Clippy component with `rustup component add clippy`, then rerun doctor."
      },
      {
        "id": "rust-nightly-runtime",
        "description": "Pinned Rust nightly 2026-07-01 required by cargo-fuzz",
        "probe": {
          "run": [
            "rustc",
            "+nightly-2026-07-01",
            "--version"
          ],
          "timeoutSeconds": 30,
          "readOnly": true,
          "outputStream": "stdout",
          "outputRegex": "^rustc 1\\.[0-9]+\\.[0-9]+-nightly \\("
        },
        "remediation": "Install `nightly-2026-07-01` with rustup, then rerun doctor."
      },
      {
        "id": "rust-runtime",
        "description": "Rust 1.85 or newer required by the workspace",
        "probe": {
          "run": [
            "rustc",
            "--version"
          ],
          "timeoutSeconds": 15,
          "readOnly": true,
          "outputStream": "stdout",
          "outputRegex": "^rustc 1\\.(?:8[5-9]|9[0-9])\\."
        },
        "remediation": "Install a Rust stable toolchain at version 1.85 or newer, then rerun doctor."
      },
      {
        "id": "rustfmt-runtime",
        "description": "rustfmt required by the Rust formatting gate",
        "probe": {
          "run": [
            "cargo",
            "fmt",
            "--version"
          ],
          "timeoutSeconds": 30,
          "readOnly": true,
          "outputStream": "stdout",
          "outputRegex": "^rustfmt\\s"
        },
        "remediation": "Install the rustfmt component with `rustup component add rustfmt`, then rerun doctor."
      }
    ],
    "setupActions": []
  }
}
