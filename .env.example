# Sao chép thành .env sau khi đã tạo OAuth client.
YOUTUBE_CLIENT_SECRET_PATH=credentials/client_secret.json
YOUTUBE_TOKEN_PATH=credentials/token.json

# Có thể đặt đường dẫn riêng cho runtime hiện tại nếu công cụ không nằm trong PATH.
LYRICRAIL_PYTHON=
LYRICRAIL_FFMPEG=
LYRICRAIL_FFPROBE=
LYRICRAIL_NVIDIA_SMI=

# Cho phép chạy CLI đã cài từ bất kỳ thư mục nào.
# Windows: E:\LyricRail
# macOS/Linux: /opt/lyricrail hoặc /home/user/LyricRail
LYRICRAIL_HOME=
