# Sao chép file này thành .env. Chỉ điền các giá trị cần ghi đè;
# giá trị trống sẽ dùng cơ chế tự phát hiện hoặc mặc định của LyricRail.

# Thư mục cài đặt/runtime LyricRail. Phải là đường dẫn tuyệt đối nếu được đặt.
# Windows: E:\LyricRail
# macOS/Linux: /opt/lyricrail hoặc /home/user/LyricRail
LYRICRAIL_HOME=

# Thư mục dữ liệu có thể ghi (jobs, output, cache và logs).
# Phải là đường dẫn tuyệt đối; để trống để dùng thư mục dữ liệu mặc định của hệ điều hành.
LYRICRAIL_DATA_HOME=

# Đường dẫn công cụ khi không muốn dùng bản tự phát hiện trong runtime hoặc PATH.
LYRICRAIL_PYTHON=
LYRICRAIL_FFMPEG=
LYRICRAIL_FFPROBE=
LYRICRAIL_LRAIL=
LYRICRAIL_NVIDIA_SMI=

# Tùy chọn cũ dành cho quy trình upload YouTube. Không cần cho Studio hoặc Player.
# Các file thật thuộc credentials/ và không được commit.
YOUTUBE_CLIENT_SECRET_PATH=credentials/client_secret.json
YOUTUBE_TOKEN_PATH=credentials/token.json
