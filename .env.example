# Optional runtime and mutable-data roots. Use absolute paths.
LYRICRAIL_HOME=
LYRICRAIL_DATA_HOME=

# Optional development tool overrides.
LYRICRAIL_PYTHON=
LYRICRAIL_FFMPEG=
LYRICRAIL_FFPROBE=
LYRICRAIL_LRAIL=
LYRICRAIL_NVIDIA_SMI=

# Google Drive desktop Picker configuration. The client ID is public app
# configuration; keep any issued client secret outside source control.
LYRICRAIL_GOOGLE_CLIENT_ID=
LYRICRAIL_GOOGLE_CLIENT_SECRET=
